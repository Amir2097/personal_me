# Production image for Цифровое Сукно UI (standalone / own domain).
# Build: docker build -f apps/billiards/Dockerfile.prod -t sukno-ui ./apps/billiards

FROM node:22-alpine AS build

WORKDIR /app

RUN apk add --no-cache ca-certificates

COPY package.json package-lock.json ./
RUN npm ci --loglevel=warn

COPY . .

# baseURL is baked at build time; standalone compose uses `/`.
ARG NUXT_APP_BASE_URL=/
ARG NUXT_PUBLIC_API_BASE_URL=
ARG NUXT_PUBLIC_HUB_URL=
ARG NUXT_PUBLIC_BRAND_NAME=Цифровое Сукно

ENV NUXT_APP_BASE_URL=$NUXT_APP_BASE_URL \
    NUXT_PUBLIC_API_BASE_URL=$NUXT_PUBLIC_API_BASE_URL \
    NUXT_PUBLIC_HUB_URL=$NUXT_PUBLIC_HUB_URL \
    NUXT_PUBLIC_BRAND_NAME=$NUXT_PUBLIC_BRAND_NAME

RUN npm run build

FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3010 \
    NITRO_HOST=0.0.0.0 \
    NITRO_PORT=3010

COPY --from=build /app/.output ./.output

EXPOSE 3010

CMD ["node", ".output/server/index.mjs"]
