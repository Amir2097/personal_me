# Цифровое Сукно API — пример переменных окружения.
# Скопируйте в .env и измените значения перед деплоем.

# --- Обязательно в production ---
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
POSTGRES_DSN=postgresql+psycopg://app:SECRET@db:5432/personal_me
FRONTEND_BASE_URL=https://sukno.example.com
CORS_ORIGINS=https://sukno.example.com

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-before-first-login
INITIAL_ADMIN_EMAIL=admin@sukno.example.com

# --- Безопасность ---
ALLOW_LEGACY_ADMIN_KEY=false
SUKNO_ADMIN_KEY=
ALLOW_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=true
EXPOSE_RESET_TOKEN=false
EXPOSE_VERIFICATION_TOKEN=false
AUTH_RATE_LIMIT_PER_MINUTE=30

COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/

# --- SMTP (сброс пароля и верификация email) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sukno.example.com
SMTP_USE_TLS=true

# --- Прочее ---
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
TOTP_ISSUER=Цифровое Сукно
TOTP_CHALLENGE_EXPIRE_MINUTES=5
UPLOADS_DIR=/app/uploads
AVATAR_MAX_BYTES=2097152

# --- Комнаты синхронизации (табло) ---
SYNC_ROOM_CODE_LENGTH=8
SYNC_ROOM_TTL_HOURS=12
